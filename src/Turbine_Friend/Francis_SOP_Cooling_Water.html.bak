<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: Sistem Rashladne Vode</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #06b6d4;
            transform: translateY(-2px);
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-cyan-500 flex items-center gap-3">
                <i data-lucide="snowflake"></i> SISTEM RASHLADNE VODE
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">Filtracija Sirove Vode & Izmjenjivači Toplote</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> OPERATIVNI CENTAR
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Strainer Logic -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="filter"></i> AUTO-FILTERI
                </h2>
                <span
                    class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">STATUS:
                    ČISTO</span>
            </div>

            <div class="space-y-4 text-sm mt-6">
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Diferencijalni Pritisak (dP)</span>
                    <span class="text-white font-mono">0.12 Bar</span>
                </div>

                <div class="p-3 bg-cyan-900/10 border border-cyan-800/30 rounded">
                    <h3 class="text-cyan-400 font-bold text-xs uppercase mb-2">Logika Ispiranja</h3>
                    <ul class="text-xs text-stone-400 space-y-1">
                        <li>• Okidač: dP > 0.5 Bar ILI Tajmer (12 h)</li>
                        <li>• Akcija: Motor rotira četku, Ventil odvoda otvoren 15s</li>
                        <li>• <span class="text-red-400">Greška Zaglavljivanja:</span> Struja Motora > 5A</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Heat Exchanger Flow -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="thermometer-snowflake"></i> HLADNJACI
                </h2>
                <span
                    class="text-xs font-bold bg-cyan-900/30 text-cyan-400 px-2 py-1 rounded border border-cyan-800">ULAZ:
                    12°C</span>
            </div>

            <div class="bg-stone-900 p-3 rounded border border-stone-800 text-sm space-y-2">
                <div class="flex justify-between items-center border-b border-stone-800 pb-2">
                    <span class="text-stone-400">Hladnjaci Zraka Generatora</span>
                    <span class="text-white font-mono">1,200 L/min</span>
                </div>
                <div class="flex justify-between items-center border-b border-stone-800 pb-2">
                    <span class="text-stone-400">Hladnjak Ulja Aksijalnog Ležaja</span>
                    <span class="text-white font-mono">450 L/min</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-stone-400">Hladnjak Ulja Vodećeg Ležaja</span>
                    <span class="text-white font-mono">150 L/min</span>
                </div>
            </div>

            <div class="mt-4 p-3 bg-stone-800 rounded">
                <div class="flex justify-between text-xs mb-1">
                    <span class="text-stone-500">Status Protokola</span>
                    <span class="text-green-500 font-bold">ISPRAVNO</span>
                </div>
                <div class="w-full bg-stone-700 h-1 rounded-full overflow-hidden">
                    <div class="bg-cyan-500 h-full w-[80%]"></div>
                </div>
            </div>
        </div>

    </div>

    <!-- Mixing Valve Logic -->
    <div class="mt-8 section-card p-6 rounded">
        <h2 class="text-lg font-bold text-stone-300 mb-4 flex items-center gap-2">
            <i data-lucide="git-merge"></i> REGULACIJA TEMPERATURE (3-KRAKI VENTIL)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
            <div class="p-3 border border-stone-700 rounded text-center">
                <div class="text-stone-500 text-xs uppercase mb-1">Zimski Mod</div>
                <div class="text-cyan-300 font-bold">RECIRKULACIJA</div>
                <p class="text-[10px] text-stone-500 mt-1">Sprečava pothlađivanje ulja (< 35°C)</p>
            </div>
            <div class="p-3 border border-stone-700 rounded text-center">
                <div class="text-stone-500 text-xs uppercase mb-1">Ljetni Mod</div>
                <div class="text-blue-500 font-bold">PUNO HLAĐENJE</div>
                <p class="text-[10px] text-stone-500 mt-1">Ciljna temp ulja 45°C</p>
            </div>
            <div class="p-3 border border-stone-700 rounded text-center bg-red-900/10 border-red-900/50">
                <div class="text-red-400 text-xs uppercase mb-1">Kvar</div>
                <div class="text-red-500 font-bold">RUČNI BAJPAS</div>
                <p class="text-[10px] text-stone-500 mt-1">Ako aktuator ventila otkaže</p>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>