<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: Braking & Jacking</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .tech-border {
            border: 1px solid #292524;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #ef4444;
            transform: translateY(-2px);
        }

        .dust-anim {
            animation: dust 3s infinite;
        }

        @keyframes dust {
            0% {
                opacity: 0;
                transform: translateY(0);
            }

            50% {
                opacity: 0.5;
                transform: translateY(-10px);
            }

            100% {
                opacity: 0;
                transform: translateY(-20px);
            }
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-red-600 flex items-center gap-3">
                <i data-lucide="octagon"></i> BRAKING SYSTEM
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">Air Brakes & Hydraulic Jacking</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> DASHBOARD
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Auto-Braking Logic -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="wind"></i> AIR BRAKES
                </h2>
                <div class="flex flex-col items-end">
                    <span class="text-xs font-bold text-red-500">PRESSURE: 7.0 BAR</span>
                    <span class="text-[10px] text-stone-500">Reservoir Full</span>
                </div>
            </div>

            <div class="space-y-4 text-sm mt-6">
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Trigger Speed</span>
                    <span class="text-white font-mono">
                        < 20% (85 RPM)</span>
                </div>
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Application Type</span>
                    <span class="text-yellow-500 font-mono">PULSING (3s ON/OFF)</span>
                </div>

                <div class="p-3 bg-red-900/10 border border-red-800/30 rounded mt-4">
                    <h3 class="text-red-400 font-bold text-xs uppercase mb-2">Safety Interlock</h3>
                    <p class="text-xs text-stone-400">
                        IF <span class="text-white font-bold">Speed > 30%</span> THEN <span
                            class="text-red-500 font-bold">BLOCK AIR</span>. Apply brakes at high speed = Fire Risk /
                        Rotor Crack.
                    </p>
                </div>
            </div>
        </div>

        <!-- Dust Extraction -->
        <div class="section-card p-6 rounded relative overflow-hidden">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="fan"></i> DUST EXTRACTOR
                </h2>
                <span
                    class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">FAN:
                    ON</span>
            </div>

            <div class="bg-stone-900 p-3 rounded border border-stone-800 text-sm space-y-2 relative z-10">
                <div class="flex justify-between">
                    <span class="text-stone-400">Filter dP</span>
                    <span class="text-white">120 Pa</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-stone-400">Run Timer</span>
                    <span class="text-white">Autostop +15 mins</span>
                </div>
            </div>

            <!-- Dust animation particles -->
            <div class="absolute bottom-0 right-10 opacity-20">
                <i data-lucide="cloud" class="w-12 h-12 text-stone-500 dust-anim" style="animation-delay: 0s;"></i>
                <i data-lucide="cloud" class="w-8 h-8 text-stone-500 dust-anim"
                    style="animation-delay: 1s; margin-left: 20px;"></i>
            </div>

            <div class="mt-4 p-3 bg-stone-800 rounded z-10 relative">
                <strong class="text-xs text-stone-300 block mb-1">HEALTH WARNING</strong>
                <p class="text-[10px] text-stone-500">Brake dust is carcinogenic. Do not enter Generator Barrel during
                    braking sequence. Wear P3 masks.</p>
            </div>
        </div>

    </div>

    <!-- Jacking Logic (Manual Lift) -->
    <div class="mt-8 section-card p-6 rounded border-l-4 border-l-amber-600">
        <h2 class="text-lg font-bold text-amber-500 mb-2 flex items-center gap-2">
            <i data-lucide="arrow-up-circle"></i> HYDRAULIC JACKING (MAINTENANCE)
        </h2>
        <div class="flex items-center gap-6">
            <div class="bg-black p-4 rounded border border-stone-700 text-center">
                <div class="text-[10px] text-stone-500 uppercase">Oil Pressure</div>
                <div class="text-2xl font-bold text-white">0 Bar</div>
            </div>
            <div class="text-sm text-stone-400">
                <p class="mb-2"><strong>Purpose:</strong> Lifts the 350-ton rotor by 10mm to flood Thrust Pads with oil
                    before start (if idle > 72 hrs).</p>
                <div class="flex gap-2">
                    <span
                        class="px-2 py-1 bg-stone-800 rounded border border-stone-700 text-green-500 text-xs">Permissive:
                        Speed 0%</span>
                    <span
                        class="px-2 py-1 bg-stone-800 rounded border border-stone-700 text-green-500 text-xs">Permissive:
                        Brakes RLSD</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>