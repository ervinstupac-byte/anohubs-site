<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LOAD REJECTION LOGIC - GRID LOSS PROTOCOL</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0f172a;
            color: #e2e8f0;
        }

        /* Flowchart Logic */
        .logic-step {
            background: #1e293b;
            border: 1px solid #334155;
            padding: 20px;
            border-radius: 8px;
            position: relative;
            z-index: 10;
        }

        .logic-step.active {
            border-color: #f59e0b;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
            background: #283044;
        }

        .logic-connector {
            position: absolute;
            left: 50%;
            top: 100%;
            width: 2px;
            height: 40px;
            background: #475569;
            transform: translateX(-50%);
            z-index: 0;
        }

        .step-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #94a3b8;
            margin-bottom: 0.5rem;
        }

        /* Interlock Box */
        .interlock-box {
            background: rgba(220, 38, 38, 0.1);
            border: 1px dashed #dc2626;
            padding: 15px;
            border-radius: 6px;
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-4xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-16 border-b border-slate-700 pb-6">
        <div>
            <h1 class="text-3xl font-black text-amber-500 tracking-tighter uppercase flex items-center gap-3">
                <i data-lucide="unlink-2"></i> LOAD REJECTION
            </h1>
            <p class="text-slate-500 font-bold tracking-widest mt-2 uppercase text-xs">Grid Loss & Overspeed Logic
                Sequence</p>
        </div>
        <div class="text-right">
            <a href="Francis_Horizontal_Dashboard.html"
                class="text-xs text-slate-500 hover:text-white transition flex items-center gap-1 justify-end">
                <i data-lucide="arrow-left"></i> DASHBOARD
            </a>
        </div>
    </header>

    <!-- Logic Flow -->
    <div class="space-y-12 relative pb-20">

        <!-- STEP 0: EVENT TRIGGER -->
        <div class="logic-step active text-center border-amber-500">
            <div class="step-title text-amber-500 font-bold">EVENT TRIGGER (T=0s)</div>
            <h2 class="text-2xl font-black text-white">GRID LOSS DETECTED</h2>
            <p class="text-xs text-slate-400 mt-2 font-mono">Breaker Open Signal (52G) Received.</p>
            <div class="logic-connector h-12"></div>
        </div>

        <!-- STEP 1: GOVERNOR REACTION -->
        <div class="logic-step">
            <div class="step-title">ACTION 01: GOVERNOR</div>
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-lg font-bold text-white">Immediate Rapid Closure</h3>
                    <p class="text-xs text-slate-400">Guide Vanes move to <span class="text-amber-400">SNL
                            (Speed-No-Load)</span> position.</p>
                </div>
                <i data-lucide="cpu" class="text-slate-600"></i>
            </div>
            <div class="logic-connector"></div>
        </div>

        <!-- STEP 2: MIV LOGIC -->
        <div class="logic-step">
            <div class="step-title">ACTION 02: MIV SEQUENCE</div>
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Initiate Closing Law</h3>
                    <p class="text-xs text-slate-400">Trigger 'Emergency Close' solenoid.</p>
                </div>
                <i data-lucide="shield-alert" class="text-slate-600"></i>
            </div>

            <div class="bg-slate-900 border border-slate-700 p-3 rounded flex items-center gap-4 text-xs font-mono">
                <span class="text-slate-500">Target Profile:</span>
                <span class="text-cyan-400">80% Fast / 20% Slow</span>
                <a href="Francis_SOP_Water_Hammer.html" class="ml-auto text-amber-500 underline hover:text-white">View
                    Physics</a>
            </div>

            <!-- Interlock Simulation -->
            <div class="interlock-box mt-4">
                <div class="flex items-start gap-3">
                    <i data-lucide="git-pull-request-closed" class="text-red-500 w-5 h-5 mt-1"></i>
                    <div>
                        <strong class="text-red-400 text-sm uppercase">Priority Interlock: MIV STUCK</strong>
                        <p class="text-[10px] text-slate-300 mt-1">
                            IF MIV Angle remains > 5&deg; after 180s:
                            <br>
                            <span class="text-white bg-red-900/50 px-1">COMMAND DISTRIBUTOR LOCK (squeeze mode)</span>
                        </p>
                    </div>
                </div>
            </div>
            <div class="logic-connector"></div>
        </div>

        <!-- STEP 3: BRAKING LOGIC -->
        <div class="logic-step">
            <div class="step-title">ACTION 03: MECHANICAL BRAKES</div>
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-lg font-bold text-white">Apply Brakes</h3>
                    <p class="text-xs text-slate-400">Wait for Speed < 20% Nominal.</p>
                </div>
                <i data-lucide="disc" class="text-slate-600"></i>
            </div>

            <div class="mt-3 flex items-center gap-2 text-xs font-mono bg-black p-2 rounded">
                <span class="text-slate-500">Logic Check:</span>
                <span class="text-green-500">SPEED &lt; 20% (TRUE)</span>
                <span class="text-slate-600">&rarr;</span>
                <span class="text-white font-bold">SOLENOID ENERGIZE</span>
            </div>
        </div>

    </div>

    <!-- Interactive Simulation -->
    <div class="mt-12 p-6 bg-slate-800 rounded-lg border border-slate-700 text-center">
        <h3 class="text-slate-400 font-bold uppercase text-xs mb-4">Logic Verification Simulation</h3>
        <button onclick="runSimulation()"
            class="px-8 py-3 bg-amber-600 hover:bg-amber-700 text-white font-black uppercase rounded shadow-lg shadow-amber-600/20 transition">
            SIMULATE GRID LOSS (52G OPEN)
        </button>
        <div id="simStatus" class="mt-4 text-xs font-mono text-slate-500 h-6">System Stable.</div>
    </div>

    <script>
        lucide.createIcons();

        function runSimulation() {
            const status = document.getElementById('simStatus');
            const steps = document.querySelectorAll('.logic-step');

            // Reset
            steps.forEach(s => s.classList.remove('active'));
            steps[0].classList.add('active'); // Trigger always active

            status.innerHTML = "<span class='text-red-500'>GRID LOSS DETECTED! INITIATING SEQUENCE...</span>";

            // Step 1
            setTimeout(() => {
                steps[1].classList.add('active');
                status.innerText = "GOVERNOR: Reducing to Speed-No-Load...";
            }, 1000);

            // Step 2
            setTimeout(() => {
                steps[2].classList.add('active');
                status.innerText = "MIV: Emergency Close Signal Sent. Monitoring Angle...";
            }, 2500);

            // Step 3
            setTimeout(() => {
                steps[3].classList.add('active');
                status.innerHTML = "<span class='text-green-500'>SEQUENCE COMPLETE: Unit Safe. Brakes Applied.</span>";
            }, 4500);
        }
    </script>
</body>

</html>