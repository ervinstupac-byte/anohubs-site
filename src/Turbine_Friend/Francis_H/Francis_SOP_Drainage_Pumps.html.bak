<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: Drainage & Dewatering</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .tech-border {
            border: 1px solid #292524;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #0ea5e9;
            transform: translateY(-2px);
        }

        .water-level-bg {
            background: linear-gradient(180deg, #1c1917 0%, #1c1917 var(--level), #0c4a6e var(--level), #0c4a6e 100%);
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-sky-500 flex items-center gap-3">
                <i data-lucide="waves"></i> DRAINAGE & DEWATERING
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">Turbine Pit & Station Sump Logic</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> DASHBOARD
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Logic Visualizer -->
        <div class="section-card p-6 rounded relative overflow-hidden">
            <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i data-lucide="cpu"></i> PUMP LOGIC (AUTO)
            </h2>

            <div class="space-y-4 text-sm">
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Level < 20%</span>
                            <span class="text-green-500 font-bold">ALL OFF</span>
                </div>
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Level > 40%</span>
                    <span class="text-sky-400 font-bold">LEAD PUMP ON</span>
                </div>
                <div class="flex justify-between items-center bg-stone-900 p-3 rounded border border-stone-800">
                    <span class="text-stone-400">Level > 70%</span>
                    <span class="text-sky-400 font-bold">LAG PUMP ON</span>
                </div>
                <div class="flex justify-between items-center bg-red-900/20 p-3 rounded border border-red-900/50">
                    <span class="text-red-400">Level > 90%</span>
                    <span class="text-red-500 font-bold animate-pulse">FLOOD ALARM</span>
                </div>
            </div>

            <div class="mt-6 p-4 bg-sky-900/10 border border-sky-800/30 rounded">
                <h3 class="text-sky-400 font-bold text-xs uppercase mb-2">Duty Cycle Rotation</h3>
                <p class="text-xs text-stone-400">Lead/Lag assignment swaps every 24 hours to equalize runtime wear.</p>
            </div>
        </div>

        <!-- Physical Checks -->
        <div class="section-card p-6 rounded">
            <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i data-lucide="clipboard-check"></i> MAINTENANCE
            </h2>

            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-stone-800 rounded text-sky-500"><i data-lucide="droplets" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <strong class="text-stone-200 block text-sm">Non-Return Check Valve</strong>
                        <p class="text-xs text-stone-500">Verify no backflow when pump stops. Hammering sound indicates
                            valve failure.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-stone-800 rounded text-orange-500"><i data-lucide="trash-2" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <strong class="text-stone-200 block text-sm">Suction Strainer</strong>
                        <p class="text-xs text-stone-500">Clear sludge/debris monthly. Cavitation noise indicates
                            blockage.</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-stone-800 rounded text-red-500"><i data-lucide="thermometer" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <strong class="text-stone-200 block text-sm">Motor Winding Temp</strong>
                        <p class="text-xs text-stone-500">Max continuous: 80°C. Check cooling fan intake.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Sludge Pump Section -->
    <div class="mt-8 section-card p-6 rounded border-l-4 border-l-amber-600">
        <h2 class="text-lg font-bold text-amber-500 mb-2">UNKNOWN SLUDGE WARNING</h2>
        <p class="text-sm text-stone-400 mb-4">Station sump may contain oil-mixed water. Ensure Oil-Water Separator
            (OWS) is active before pumping to tailrace.</p>
        <div class="flex items-center gap-4 text-xs font-mono">
            <span class="px-2 py-1 bg-green-900/30 text-green-400 border border-green-800 rounded">OWS: HEALTHY</span>
            <span class="px-2 py-1 bg-stone-800 text-stone-500 border border-stone-700 rounded">PPM: < 5mg/L</span>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>