<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HITNI SOP: HIDRAULIČNI UDAR</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');

        body {
            background-color: #000000;
            color: #ffffff;
            font-family: 'JetBrains Mono', monospace;
        }

        .warning-strip {
            background: repeating-linear-gradient(45deg,
                    #000,
                    #000 10px,
                    #dc2626 10px,
                    #dc2626 20px);
            height: 12px;
            width: 100%;
        }

        .panel-critical {
            border: 2px solid #dc2626;
            background: #1a0505;
        }

        .closing-chart-container {
            position: relative;
            height: 200px;
            border-left: 2px solid #fff;
            border-bottom: 2px solid #fff;
            margin: 20px;
        }

        .closing-line {
            position: absolute;
            background: #dc2626;
            height: 2px;
            transform-origin: left bottom;
        }

        .metric-red {
            color: #f87171;
            text-shadow: 0 0 10px #dc2626;
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-6xl mx-auto">

    <!-- Header -->
    <div class="warning-strip mb-6"></div>
    <header class="flex justify-between items-center mb-12 border-b-4 border-red-600 pb-6">
        <div>
            <h1 class="text-5xl font-black text-red-600 tracking-tighter uppercase flex items-center gap-4">
                <i data-lucide="zap-off" class="w-12 h-12"></i>
                HIDRAULIČNI UDAR
            </h1>
            <p class="text-white font-bold tracking-widest mt-2 uppercase">Kritični Fizički Limiti • W-04-WH Protokol
            </p>
        </div>
        <div class="text-right">
            <div class="bg-red-600 text-black font-black px-4 py-2 uppercase text-xl">
                ALARM MAX PRITISKA
            </div>
            <div class="text-red-500 font-mono mt-1">AKO JE &Delta;P > 25% &rarr; EVAKUACIJA</div>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- LEFT: CLOSING LAW PHYSICS -->
        <div>
            <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-red-600 pl-4 uppercase">
                1. Zakon Zatvaranja (Logika 2 Faze)
            </h2>
            <div class="panel-critical p-6 rounded-none">
                <p class="text-sm text-gray-300 mb-4">
                    Da bi se spriječilo pucanje cjevovoda tokom Ispada Tereta, Glavni Ulazni Ventil (GUV) se MORA
                    zatvoriti u dvije
                    različite faze.
                </p>

                <!-- Visualization -->
                <div class="closing-chart-container bg-black/50">
                    <!-- Stage 1: Fast -->
                    <div
                        class="absolute bottom-[20%] left-0 w-[60%] h-[80%] border-t border-r border-dashed border-gray-600">
                    </div>
                    <div class="absolute left-2 top-2 text-xs text-red-400">100% OTVORENO</div>

                    <!-- Line 1: 100% to 20% quickly -->
                    <svg class="absolute inset-0 w-full h-full">
                        <line x1="0" y1="0" x2="60%" y2="80%" stroke="#dc2626" stroke-width="4" />
                        <!-- Line 2: 20% to 0% slowly -->
                        <line x1="60%" y1="80%" x2="100%" y2="100%" stroke="#dc2626" stroke-width="4" />
                    </svg>

                    <div class="absolute bottom-0 left-[60%] w-px h-full bg-gray-700 border-l border-dashed"></div>
                    <div class="absolute bottom-2 left-[65%] text-xs text-white">SPORA FAZA (Jastuk)</div>
                    <div class="absolute top-[50%] left-[20%] text-xs text-white rotate-[-45deg]">BRZA FAZA (80%)</div>
                </div>

                <ul class="text-xs space-y-2 mt-4 font-mono text-red-300">
                    <li class="flex justify-between"><span>FAZA 1 (BRZA):</span> <strong>100% &rarr; 20% u
                            45s</strong></li>
                    <li class="flex justify-between"><span>FAZA 2 (JASTUK):</span> <strong>20% &rarr; 0% u
                            120s</strong></li>
                    <li class="flex justify-between border-t border-red-900 pt-2"><span>KRITIČNA BLOKADA:</span>
                        <strong>AKO TAJMER &lt; 165s &rarr; TRIP</strong>
                    </li>
                </ul>
            </div>
        </div>

        <!-- RIGHT: CRITICAL PRESSURE & SURGE TANK -->
        <div class="space-y-8">

            <!-- Pressure Limits -->
            <div>
                <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-red-600 pl-4 uppercase">
                    2. Granice Pritiska (Tvrdi Stop)
                </h2>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-900 p-4 border border-gray-700">
                        <div class="text-xs text-gray-500 uppercase">Nominalni Pad</div>
                        <div class="text-2xl font-bold text-white">14.5 Bar</div>
                    </div>
                    <div class="bg-red-900/20 p-4 border border-red-600">
                        <div class="text-xs text-red-400 uppercase font-black">MAX LIMIT UDARA (+25%)</div>
                        <div class="text-2xl font-black text-red-500">18.1 Bar</div>
                    </div>
                </div>
            </div>

            <!-- Surge Tank / Vacuum -->
            <div>
                <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-red-600 pl-4 uppercase">
                    3. Vodostan & Logika Vakuuma
                </h2>
                <div class="panel-critical p-6">
                    <h3 class="text-red-500 font-bold mb-2 flex items-center gap-2">
                        <i data-lucide="wind"></i> PROVJERA VAZDUŠNOG VENTILA
                    </h3>
                    <p class="text-xs text-gray-300 mb-4">
                        Tokom brzog zatvaranja, separacija vodenog stuba može stvoriti vakuum. Vazdušni ventili se
                        MORAJU otvoriti da
                        spriječe kolaps cijevi.
                    </p>
                    <div class="flex items-center gap-4 bg-black p-3 border border-red-900">
                        <div class="w-3 h-3 bg-green-500 rounded-full animate-ping"></div>
                        <span class="text-sm font-bold text-white">STATUS VENTILA: SLOBODAN / ČIST</span>
                    </div>
                </div>
            </div>

            <!-- Anchor Audit -->
            <div>
                <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-red-600 pl-4 uppercase">
                    4. Revizija Nakon Događaja
                </h2>
                <div class="bg-gray-900 p-4 border-l-4 border-yellow-500">
                    <h4 class="text-yellow-500 font-bold uppercase text-sm mb-2">PROVJERI ANKER BLOKOVE (M-04-ANC)</h4>
                    <p class="text-xs text-gray-400">
                        Nakon bilo kojeg W-04-WH Alarm događaja, vizuelno pregledaj anker blokove Spirale na pomjeranje
                        ili
                        pucanje betona.
                    </p>
                </div>
            </div>

        </div>

    </div>

    <!-- Footer Action -->
    <div class="mt-12 text-center">
        <a href="Francis_Horizontal_Dashboard.html"
            class="inline-block px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-black uppercase tracking-widest transition">
            POTVRDI KRITIČNI SOP & POVRATAK
        </a>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>