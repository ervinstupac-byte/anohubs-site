<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: DC Energetski Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .tech-border {
            border: 1px solid #292524;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #eab308;
            transform: translateY(-2px);
        }

        .batt-cell {
            width: 10px;
            height: 20px;
            background: #333;
            margin: 1px;
            display: inline-block;
        }

        .batt-ok {
            background: #22c55e;
        }

        .batt-weak {
            background: #eab308;
        }

        .batt-bad {
            background: #ef4444;
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-yellow-500 flex items-center gap-3">
                <i data-lucide="battery-charging"></i> DC ENERGETSKI SISTEMI
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">110V Kontrolna & 24V Instrumentaciona Logika</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> OPERATIVNI CENTAR
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- 110V Bank (The Brain Power) -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="zap"></i> 110VDC BLOK
                </h2>
                <span
                    class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">FLOAT:
                    122.5V</span>
            </div>
            <p class="text-xs text-stone-500 mb-4">Napaja: Trip Kaleme, Motore Regulatora, Zaštitne Releje.</p>

            <div class="mb-4">
                <!-- Visual Battery Array -->
                <div class="flex flex-wrap gap-1 mb-2">
                    <!-- Generating visual cells -->
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-weak"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                    <div class="batt-cell batt-ok"></div>
                </div>
                <p class="text-[10px] text-yellow-500">Upozorenje Impedanse Ćelije #6 (>20mΩ)</p>
            </div>

            <div class="bg-stone-900 p-3 rounded border border-stone-800 text-sm space-y-2">
                <div class="flex justify-between"><span>Vrijeme Autonomije:</span> <span class="text-white">8
                        Sati</span>
                </div>
                <div class="flex justify-between"><span>Struja Tereta:</span> <span class="text-white">12.4 A</span>
                </div>
                <div class="flex justify-between"><span>Zemljospoj:</span> <span class="text-green-500">NEGATIVAN</span>
                </div>
            </div>
        </div>

        <!-- 24V Bank (The Sensors) -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="cpu"></i> 24VDC BLOK
                </h2>
                <span
                    class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">FLOAT:
                    27.1V</span>
            </div>
            <p class="text-xs text-stone-500 mb-4">Napaja: PLC IO, Transduktore, Solenoidne Ventile.</p>

            <div class="bg-stone-900 p-3 rounded border border-stone-800 text-sm space-y-2">
                <div class="flex justify-between"><span>Redundancija:</span> <span class="text-white">Punjač A +
                        B</span>
                </div>
                <div class="flex justify-between"><span>Šum Izlaza:</span> <span class="text-white">
                        < 50 mVpp</span>
                </div>
            </div>

            <div class="mt-4 p-3 bg-red-900/10 border border-red-900/50 rounded">
                <h3 class="text-red-400 font-bold text-xs uppercase mb-1">Kritični Mod Kvara</h3>
                <p class="text-[10px] text-stone-400">Gubitak 24V okida "Fail-Safe" na svoj hidraulici. MIV i Sprovodne
                    Lopatice će se zatvoriti gravitacijom/oprugama.</p>
            </div>
        </div>

    </div>

    <!-- Maintenance SOP -->
    <div class="mt-8">
        <h2 class="text-lg font-bold text-stone-300 mb-4">LOGIKA KVARTALNOG ODRŽAVANJA</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-stone-400">
                <thead class="bg-stone-900 text-stone-200 uppercase text-xs">
                    <tr>
                        <th class="p-3">Provjera</th>
                        <th class="p-3">Parametar</th>
                        <th class="p-3">Fail Logika</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-800 border-b border-stone-800 bg-stone-950/50">
                    <tr>
                        <td class="p-3">Nivo Elektrolita</td>
                        <td class="p-3">Između Max/Min</td>
                        <td class="p-3 text-yellow-500">Dopuni Destilovanom Vodom</td>
                    </tr>
                    <tr>
                        <td class="p-3">Priključni Spojevi</td>
                        <td class="p-3">Moment 10Nm / Nema Korozije</td>
                        <td class="p-3 text-red-500">Očisti & Dategni</td>
                    </tr>
                    <tr>
                        <td class="p-3">Monitor Zemljospoja</td>
                        <td class="p-3">> 20 kΩ Izolacija</td>
                        <td class="p-3 text-red-500">Prati Petlju Uzemljenja</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>