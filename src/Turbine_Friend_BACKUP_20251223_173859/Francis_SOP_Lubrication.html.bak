<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: Sistem Podmazivanja</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #d97706;
            transform: translateY(-2px);
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-amber-500 flex items-center gap-3">
                <i data-lucide="droplet"></i> KONTROLA PODMAZIVANJA
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">Sistem Centralne Masti & Kvalitet Ulja</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> OPERATIVNI CENTAR
        </a>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Auto-Lube System (The Grease Pump) -->
        <div class="section-card p-6 rounded lg:col-span-2">
            <div class="flex justify-between items-start mb-6">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="settings"></i> CENTRALNI SISTEM MASTI
                </h2>
                <div class="flex gap-2">
                    <span
                        class="text-xs font-bold bg-amber-900/30 text-amber-500 px-2 py-1 rounded border border-amber-800">CIKLUSI:
                        12/Dan</span>
                    <span
                        class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">PUMPA:
                        SPREMNA</span>
                </div>
            </div>

            <!-- Distribution Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-stone-400">
                    <thead class="bg-stone-900 text-stone-200 uppercase text-xs">
                        <tr>
                            <th class="p-3">Zona</th>
                            <th class="p-3">Tačke</th>
                            <th class="p-3">Doziranje</th>
                            <th class="p-3">Povratna Veza</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-800 border-b border-stone-800 bg-stone-950/50">
                        <tr>
                            <td class="p-3 font-bold text-amber-500">Regulacioni Prsten</td>
                            <td class="p-3">4 (Kvadranta)</td>
                            <td class="p-3">5cc / Ciklus</td>
                            <td class="p-3 text-green-500">Presostat OK</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-bold text-amber-500">Gornja Čahura Sprovodnog Aparata</td>
                            <td class="p-3">20 (Čahura)</td>
                            <td class="p-3">2cc / Ciklus</td>
                            <td class="p-3 text-green-500">Kraj Linije OK</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-bold text-amber-500">Donja Čahura Sprovodnog Aparata</td>
                            <td class="p-3">20 (Čahura)</td>
                            <td class="p-3">2cc / Ciklus</td>
                            <td class="p-3 text-green-500">Kraj Linije OK</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-bold text-amber-500">Bolcne Polužja</td>
                            <td class="p-3">40 (Zglobova)</td>
                            <td class="p-3">1cc / Ciklus</td>
                            <td class="p-3 text-stone-500">Vizuelna Provjera.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-4 p-3 bg-amber-900/10 border border-amber-800/30 rounded flex items-center gap-3">
                <i data-lucide="alert-circle" class="text-amber-500"></i>
                <p class="text-xs text-stone-400"><strong>Logika Blokirane Linije:</strong> Ako Pritisak Sistema > 250
                    Bar,
                    Pumpa ispada da spriječi pucanje cijevi. Provjeri blokove razdjelnika.</p>
            </div>
        </div>

        <!-- Manual Points & Inventory -->
        <div class="section-card p-6 rounded">
            <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i data-lucide="clipboard"></i> TIPOVI MAZIVA
            </h2>

            <div class="space-y-4">
                <div class="p-3 bg-stone-900 rounded border border-stone-800">
                    <span class="text-xs text-stone-500 uppercase block mb-1">Litijumska EP2 Mast</span>
                    <strong class="text-white">Glavni Auto-Sistem</strong>
                    <div class="text-[10px] text-green-400 mt-1">Zaliha: 40kg Bure (80%)</div>
                </div>
                <div class="p-3 bg-stone-900 rounded border border-stone-800">
                    <span class="text-xs text-stone-500 uppercase block mb-1">Grafitna Pasta</span>
                    <strong class="text-white">Klizne Ploče Polužja</strong>
                    <div class="text-[10px] text-stone-400 mt-1">Primijeni ručno mjesečno</div>
                </div>
                <div class="p-3 bg-stone-900 rounded border border-stone-800">
                    <span class="text-xs text-stone-500 uppercase block mb-1">ISO VG 46 Ulje</span>
                    <strong class="text-white">Regulator / Ležajevi</strong>
                    <div class="text-[10px] text-green-400 mt-1">Nivo: Normalan</div>
                </div>
            </div>

            <div class="mt-6 border-t border-stone-800 pt-4">
                <h3 class="text-stone-300 font-bold text-sm mb-2">Ruta Ručne Revizije</h3>
                <ul class="text-xs text-stone-400 space-y-2 list-disc list-inside">
                    <li>Mazalice Rukavca GUV-a (x2)</li>
                    <li>Uške Klipnjače Servomotora (x2)</li>
                    <li>Vodilice Cilindra Kočnice (x6)</li>
                </ul>
            </div>
        </div>

    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>