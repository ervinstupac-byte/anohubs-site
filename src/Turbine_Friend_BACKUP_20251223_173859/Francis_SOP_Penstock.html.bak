<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP: Integritet Tlačnog Cjevovoda</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0c0a09;
            color: #a8a29e;
        }

        .tech-border {
            border: 1px solid #292524;
        }

        .section-card {
            background: #1c1917;
            border: 1px solid #44403c;
            transition: all 0.2s;
        }

        .section-card:hover {
            border-color: #0ea5e9;
            transform: translateY(-2px);
        }
    </style>
</head>

<body class="p-6 md:p-12 max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-10 border-b border-stone-800 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-cyan-500 flex items-center gap-3">
                <i data-lucide="container"></i> INTEGRITET CJEVOVODA
            </h1>
            <p class="text-stone-500 font-mono text-xs mt-1">Tlačni Cjevovod, Anker Blokovi & Kompenzatori</p>
        </div>
        <a href="Francis_Horizontal_Dashboard.html"
            class="text-xs text-stone-500 hover:text-white transition flex items-center gap-1">
            <i data-lucide="layout-dashboard"></i> OPERATIVNI CENTAR
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Thickness & Corrosion -->
        <div class="section-card p-6 rounded">
            <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i data-lucide="scan-line"></i> DEBLJINA ZIDA (UT)
            </h2>
            <div class="space-y-4 text-sm">
                <div class="bg-stone-900 p-3 rounded border border-stone-800">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-stone-400">Sekcija A (Zahvat)</span>
                        <span class="text-white font-mono">12.4mm</span>
                    </div>
                    <div class="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-green-500 h-full w-[95%]"></div>
                    </div>
                </div>
                <div class="bg-stone-900 p-3 rounded border border-stone-800">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-stone-400">Sekcija B (Koljeno)</span>
                        <span class="text-yellow-500 font-mono">11.8mm</span>
                    </div>
                    <div class="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-yellow-500 h-full w-[90%]"></div>
                    </div>
                    <p class="text-[10px] text-yellow-600 mt-1">Vruća Tačka Erozije: Provjeriti godišnje.</p>
                </div>
            </div>
        </div>

        <!-- Expansion Joints -->
        <div class="section-card p-6 rounded">
            <div class="flex justify-between items-start mb-4">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="move-horizontal"></i> KOMPENZATOR (DILATACIJA)
                </h2>
                <span
                    class="text-xs font-bold bg-green-900/30 text-green-400 px-2 py-1 rounded border border-green-800">BEZ
                    CURENJA</span>
            </div>

            <div class="bg-stone-900 p-3 rounded border border-stone-800 text-sm space-y-2">
                <div class="flex justify-between">
                    <span class="text-stone-400">Pomjeranje (Ljeto)</span>
                    <span class="text-white">+12mm</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-stone-400">Pomjeranje (Zima)</span>
                    <span class="text-white">-8mm</span>
                </div>
            </div>

            <div class="mt-4 p-3 bg-stone-800 rounded">
                <strong class="text-xs text-stone-300 block mb-1">ODRŽAVANJE</strong>
                <p class="text-[10px] text-stone-500">Ubrizgati zaptivnu mast (Grafitnu) ako se pojavi vlaženje. Ne
                    preitezati vijke pletenice (rizik od zaribavanja).</p>
            </div>
        </div>

    </div>

    <!-- Anchor Block Stability -->
    <div class="mt-8 section-card p-6 rounded border-l-4 border-l-red-600">
        <h2 class="text-lg font-bold text-red-500 mb-2 flex items-center gap-2">
            <i data-lucide="anchor"></i> STABILNOST ANKER BLOKA (KOD: M-04-ANC)
        </h2>
        <p class="text-sm text-stone-400 mb-4">Kritična strukturna provjera nakon događaja Hidrauličkog Udara.</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
            <div class="p-3 bg-black rounded border border-stone-800">
                <strong class="text-white block mb-1">Vizuelna Provjera Pukotina</strong>
                <span class="text-stone-500">Provjeriti beton na nove pukotine > 1mm.</span>
            </div>
            <div class="p-3 bg-black rounded border border-stone-800">
                <strong class="text-white block mb-1">Pomjeranje Oslonaca</strong>
                <span class="text-stone-500">Provjeriti markere na kliznim osloncima.</span>
            </div>
            <div class="p-3 bg-black rounded border border-stone-800">
                <strong class="text-white block mb-1">Drenaža</strong>
                <span class="text-stone-500">Osigurati da su drenažni otvori bloka čisti za sprečavanje uzgona.</span>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>